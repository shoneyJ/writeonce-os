# /etc/writeonce/home/flake.nix — WriteOnce user environment via Home Manager.
#
# Home Manager is the Nix way to manage ~/.config declaratively: it builds a
# user "generation" and symlinks ~/.config/{hypr,quickshell,nvim,alacritty,fish,…}
# into the Nix store. This flake supersedes the old desktop/flake.nix (its package
# set folds into home.nix) and the raw skeleton .config files.
#
# Activated on first boot by wo-session (pinned by this flake's own flake.lock):
#     nix run /etc/writeonce/home#homeConfigurations.writeonce.activationPackage
#
# Selection/config only — no package definitions authored (consume nixpkgs as-is).
# flake.lock is generated by `nix` on the target (absent on the build host);
# commit it for full reproducibility.
{
  description = "WriteOnce user environment (Home Manager)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, home-manager }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
    in {
      homeConfigurations."writeonce" = home-manager.lib.homeManagerConfiguration {
        inherit pkgs;
        modules = [ ./home.nix ];
      };
    };
}
