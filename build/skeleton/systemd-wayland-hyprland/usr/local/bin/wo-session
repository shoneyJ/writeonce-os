#!/bin/sh
# /usr/local/bin/wo-session — WriteOnce Wayland (Hyprland) session launcher.
#
# Run (not exec'd) from ~/.bash_profile on tty1 after autologin. The desktop
# (Hyprland, Quickshell, alacritty) + its ~/.config are managed by Home Manager
# — /etc/writeonce/home/{flake,home}.nix. This script:
#   1. exports the Wayland/Qt session environment,
#   2. builds + activates the Home Manager generation on first boot (needs network),
#   3. exec's Hyprland.
# On any failure it exits non-zero so ~/.bash_profile falls back to a shell
# (never hangs the only console).

set -u

# ---- session environment ---------------------------------------------------
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND=wayland,x11
export MOZ_ENABLE_WAYLAND=1
export SDL_VIDEODRIVER=wayland
# Broadwell (Gen8) iris: software cursors avoid hardware cursor-plane glitches
# (complements the kernel cmdline i915.enable_psr/fbc/dc=0 mitigations).
export WLR_NO_HARDWARE_CURSORS=1
# XDG_RUNTIME_DIR (/run/user/<uid>) is provided by logind (pam_systemd).
[ -d "${XDG_RUNTIME_DIR:-}" ] || echo "wo-session: warning: XDG_RUNTIME_DIR unset (logind?)" >&2

# ---- realize the desktop with Home Manager on first boot -------------------
if ! command -v Hyprland >/dev/null 2>&1; then
    if command -v nix >/dev/null 2>&1 && [ -e /etc/writeonce/home/flake.nix ]; then
        echo "wo-session: first boot — building the desktop with Home Manager (needs network)…"
        # Wait for a default route — iwd association + dhcpcd lease take a few
        # seconds, and multi-user.target does not guarantee network-online.
        n=0
        while [ "$n" -lt 60 ] && ! ip route 2>/dev/null | grep -q '^default'; do
            sleep 2; n=$((n + 1))
        done
        ip route 2>/dev/null | grep -q '^default' \
            || echo "wo-session: no network yet — HM build may fail; check ethernet/Wi-Fi." >&2
        # Build the Home Manager generation (pinned by /etc/writeonce/home/flake.lock)
        # and run its activation script — installs packages + symlinks ~/.config.
        # Idempotent: a later boot re-activates the same generation (no-op).
        hm=$(nix build --no-link --print-out-paths \
                /etc/writeonce/home#homeConfigurations.writeonce.activationPackage 2>&1) \
            && "$hm/activate" \
            || echo "wo-session: Home Manager activation failed: $hm" >&2
        # Pick up the freshly-built HM profile in this already-running shell.
        [ -d "$HOME/.nix-profile/bin" ] && PATH="$HOME/.nix-profile/bin:$PATH"
        [ -r "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ] \
            && . "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
    else
        echo "wo-session: Nix is not bootstrapped yet (Phase 14) — cannot start Hyprland." >&2
        echo "            Bootstrap Nix, then build the HM generation:" >&2
        echo "            nix run /etc/writeonce/home#homeConfigurations.writeonce.activationPackage" >&2
        exit 1
    fi
fi

command -v Hyprland >/dev/null 2>&1 || {
    echo "wo-session: Hyprland still unavailable after HM activation — dropping to shell." >&2
    exit 1
}

# Hyprland creates WAYLAND_DISPLAY itself.
exec Hyprland
