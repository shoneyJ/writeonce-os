#!/bin/sh
# /usr/local/bin/wo-session — WriteOnce Wayland (Hyprland) session launcher.
#
# Run (not exec'd) from ~/.bash_profile on tty1 after autologin. The compositor
# + shell (Hyprland, Quickshell, terminal) are Tier-2 Nix packages — see
# /etc/writeonce/desktop-packages. This script:
#   1. exports the Wayland/Qt session environment,
#   2. realizes the desktop profile from Nix on first boot (needs network),
#   3. exec's Hyprland.
# On any failure it exits non-zero so ~/.bash_profile falls back to a shell
# (never hangs the only console).

set -u

# ---- session environment ---------------------------------------------------
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND=wayland,x11
export MOZ_ENABLE_WAYLAND=1
export SDL_VIDEODRIVER=wayland
# Broadwell (Gen8) iris: software cursors avoid hardware cursor-plane glitches
# (complements the kernel cmdline i915.enable_psr/fbc/dc=0 mitigations).
export WLR_NO_HARDWARE_CURSORS=1
# XDG_RUNTIME_DIR (/run/user/<uid>) is provided by logind (pam_systemd).
[ -d "${XDG_RUNTIME_DIR:-}" ] || echo "wo-session: warning: XDG_RUNTIME_DIR unset (logind?)" >&2

# ---- realize the desktop from Nix on first boot ----------------------------
if ! command -v Hyprland >/dev/null 2>&1; then
    if command -v nix >/dev/null 2>&1 && [ -r /etc/writeonce/desktop-packages ]; then
        echo "wo-session: first boot — installing the desktop from Nix (needs network)…"
        while IFS= read -r pkg; do
            case "$pkg" in ''|\#*) continue ;; esac
            nix profile install "$pkg" \
                || echo "wo-session: 'nix profile install $pkg' failed" >&2
        done < /etc/writeonce/desktop-packages
    else
        echo "wo-session: Nix is not bootstrapped yet (Phase 14) — cannot start Hyprland." >&2
        echo "            Bootstrap Nix, then: nix profile install \$(grep -v '^#' /etc/writeonce/desktop-packages)" >&2
        exit 1
    fi
fi

command -v Hyprland >/dev/null 2>&1 || {
    echo "wo-session: Hyprland still unavailable after install — dropping to shell." >&2
    exit 1
}

# Hyprland creates WAYLAND_DISPLAY itself.
exec Hyprland
