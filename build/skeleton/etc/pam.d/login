# PAM stack for shadow's /bin/login (used by the getty autologin).
# Minimal happy-path stack: pam_unix for auth/account/session, plus
# pam_systemd so logind registers the session (XDG_RUNTIME_DIR, seat0,
# VT) — which is what i3More's logind calls (GetSessionByPID, Inhibit,
# Lock) rely on. pam_systemd is `optional` so a logind hiccup never
# blocks login.
auth      required   pam_unix.so
account   required   pam_unix.so
session   required   pam_unix.so
session   optional   pam_systemd.so
