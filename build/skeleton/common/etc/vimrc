" Begin /etc/vimrc — system-wide vim config (LFS Ch8 baseline).
"
" vim is the tier-1 base editor; src/feature.h was built with
" SYS_VIMRC_FILE="/etc/vimrc", so vim reads this on startup.

" Ensure defaults are set before customizing settings, not after.
source $VIMRUNTIME/defaults.vim
let skip_defaults_vim=1

set nocompatible
set backspace=2
set mouse=
syntax on
if (&term == "xterm") || (&term == "putty")
  set background=dark
endif

" End /etc/vimrc
