# WriteOnce OS — kernel config delta for ThinkPad T450.
#
# Applied on top of `make defconfig` via scripts/kconfig/merge_config.sh.
# Each option is justified by a device or subsystem in .agents/target-machine.md
# or by a WriteOnce design decision in plan/phase-2-minimal-linux.md.

# --- UEFI boot (T450 firmware is UEFI 64-bit, Secure Boot off) ---
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_FB_EFI=y

# --- Storage controller: Intel Wildcat Point-LP SATA AHCI [8086:9c83] ---
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_PMP=y

# --- Filesystems on the SSD ---
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Wired ethernet: Intel I218-LM [8086:15a2] ---
CONFIG_E1000E=y

# --- GPU + framebuffer: Intel HD Graphics 5500 [8086:1616] ---
CONFIG_DRM=y
CONFIG_DRM_I915=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Lets the DRM stack (i915 on T450's HD 5500) expose a fbdev so the
# console keeps working after i915 grabs the GPU. Without this, the
# kernel uses efifb until i915 deactivates it — symptom is a screen
# that goes black right after "EFI stub: loaded initrd...".
CONFIG_DRM_FBDEV_EMULATION=y
# simpledrm — minimal "just paint via GOP" framebuffer that has no
# hardware-specific code. Lives alongside i915; if i915 fails to bind
# or hangs during mode-set, simpledrm keeps the console alive.
# This is the framebuffer Ubuntu / Fedora ship as a universal fallback.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y

# --- USB (xHCI + EHCI controllers on the T450) ---
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
# USB mass-storage MUST be built-in (=y, not =m). Booting from a USB
# stick means the rootfs lives on that USB; if the driver is a module
# it can't be loaded because we can't see the disk to read it from.
# CONFIG_USB_UAS = USB Attached SCSI, used by every modern USB 3.x stick.
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# --- PS/2 touchpad + TrackPoint (T450 Synaptics clickpad on the i8042 AUX port) ---
# psmouse MUST be built-in (=y): defconfig ships CONFIG_MOUSE_PS2=m, and with no
# initramfs the module wasn't autoloaded for the AUX serio port, so Xorg saw only
# the AT keyboard — no pointer at all. The Synaptics/TrackPoint sub-drivers are
# already =y (compiled into psmouse); building psmouse in guarantees the touchpad
# + TrackPoint work at boot.
CONFIG_MOUSE_PS2=y

# --- Audio: Broadwell-U + Wildcat Point-LP HDA ---
CONFIG_SND=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_CODEC_REALTEK=y
# pipewire 1.2 probes /proc/asound/timers at startup via libasound's
# hrtimer backend; Ubuntu ships this =m, which would trap the same
# way CRYPTO_USER_API did for iwd. Pin =y so the timer backend is
# unconditionally present at PID-1 time.
CONFIG_SND_HRTIMER=y

# --- CPU microcode update path ---
CONFIG_MICROCODE=y
CONFIG_MICROCODE_INTEL=y

# --- cgroup v2 (required by Phase 4 supervisor) ---
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_FREEZER=y

# --- Wireless (Intel 7265), Bluetooth, card reader — loaded as modules ---
# cfg80211 + mac80211 are pinned =y rather than =m so they're present
# at PID-1 time regardless of modprobe ordering. Otherwise iwd starts
# before mac80211 loads and finds zero phys. Cost: ~600 KiB image growth.
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_MMC=m
CONFIG_MISC_RTSX=m

# --- Crypto (required by iwd 3.3 + 802.11 PMF/WPA3) ---
# iwd opens AF_ALG sockets at startup and probes for hash/skcipher
# algorithms. Ubuntu's base config ships these as =m, but they're not
# loaded before iwd runs — iwd then warns "WPS will not be available"
# and bails. Pin =y so the user-API is unconditionally present.
# See docs/learning/phase-8f-network-stack.md for the canonical list.
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_RNG=y
# CMAC for AES-CMAC / 802.11w PMF; CCM for WPA3 personal.
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CCM=y

# --- Initramfs compression (zstd for Phase 5 Rust initramfs; gzip transitional) ---
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# ============================================================================
# Container support — Docker / Podman / youki / nerdctl all need these.
# See docs/learning/containers-kernel-requirements.md for what each enables.
# ============================================================================

# Linux namespaces (the primary isolation primitive).
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_NS=y
CONFIG_TIME_NS=y

# OverlayFS — container image layering ("union mount" of read-only layers).
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_OVERLAY_FS_INDEX=y

# Bridge + veth + virtual interfaces — the standard container network plumbing.
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=m
CONFIG_VLAN_8021Q=m
CONFIG_VETH=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m

# Netfilter (nftables-first; iptables compatibility via xtables).
CONFIG_NETFILTER=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NF_NAT=m
CONFIG_NF_CONNTRACK=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m

# Seccomp BPF — per-container syscall filtering.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Extra cgroup controllers a container runtime expects.
CONFIG_CPUSETS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMCG_SWAP=y

# Misc container kernel deps.
CONFIG_HUGETLBFS=y
CONFIG_SWAP=y

# ============================================================================
# Developer tooling — perf, bcc, bpftrace, strace, ftrace.
# ============================================================================

# BPF + BTF (the modern observability stack).
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# ftrace / kprobes / uprobes / perf events.
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBES=y
CONFIG_UPROBES=y
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y

# ============================================================================
# with-systmed branch — boot systemd directly off the SATA SSD, NO initramfs.
# The kernel must mount root itself, so the SATA disk path is built-in (=y),
# and root= uses PARTUUID (the kernel reads the GPT directly; it can't resolve
# a filesystem LABEL/UUID without an initramfs). See build/skeleton/boot/grub/grub.cfg.
# ============================================================================

# SCSI disk layer — libata/AHCI presents the Samsung SSD as /dev/sda through
# SCSI, so the disk driver MUST be built-in (=y) to mount root with no initramfs.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_MOD=y

# systemd hard requirement: open_by_handle_at() (name_to_handle_at).
CONFIG_FHANDLE=y

# systemd recommended: autofs for its automount units; tmpfs xattrs + POSIX
# ACLs for /run + /tmp (logind/tmpfiles set these).
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# Built-in kernel command line. GRUB is rejected by the T450's Aptio-V firmware
# (see 18-make-artifacts.sh history), and we ship no Rust bootloader on this
# branch, so the kernel's own EFI stub IS the bootloader: the firmware loads
# bzImage as \EFI\BOOT\BOOTX64.EFI with no load options, so the cmdline must be
# baked in here. root= uses the fixed PARTUUID install.sh assigns to the root
# partition (matches build/skeleton/... + build/install.sh). No `quiet` yet —
# keep first boots verbose. rootwait covers slow USB/SATA enumeration.
CONFIG_CMDLINE_BOOL=y
# i915 display-feature disables: Broadwell (Gen8) HD 5500 hard-hangs at console/
# DRM handoff with PSR/FBC/DC enabled (dead keyboard, no VT switch, CPU soft-lockup).
# These are the standard Intel-laptop mitigations. If the hang persists, the next
# step is i915.modeset=0 (confirm-test → simpledrm console, proves i915 is the cause).
CONFIG_CMDLINE="console=tty0 root=PARTUUID=b0007001-c0de-4f5e-9abc-000000000002 rootwait rw i915.enable_psr=0 i915.enable_fbc=0 i915.enable_dc=0 init=/usr/lib/systemd/systemd"
